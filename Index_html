<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sri Lanka: El Despertar de los Sentidos · Renace Viajando</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Crimson+Pro:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --gold: #C9A84C;
    --gold-light: #E8C96B;
    --deep: #0D0A05;
    --bark: #1A1208;
    --earth: #2C1F0E;
    --cream: #F5EDD8;
    --cream-light: #FBF6EC;
    --leaf: #3D6B2C;
    --terra: #A0442A;
    --text: #1C1207;
    --text-soft: #4A3B25;
    --blue-cta: #1a73e8;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    background: var(--cream-light);
    color: var(--text);
    font-family: 'Crimson Pro', Georgia, serif;
    font-size: 20px;
    line-height: 1.7;
    overflow-x: hidden;
    padding-bottom: 72px;
  }

  /* ══ TOP STRIP ══ */
  .top-strip {
    background: var(--terra);
    text-align: center;
    padding: 0.65rem 1rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    color: #fff;
    letter-spacing: 0.03em;
  }
  .top-strip strong { font-weight: 700; }
  .pill {
    display: inline-block;
    background: rgba(255,255,255,0.25);
    border-radius: 4px;
    padding: 0.1em 0.55em;
    font-weight: 700;
    margin: 0 0.25em;
  }

  /* ══ HERO ══ */
  .hero {
    min-height: 100vh;
    background: var(--deep);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    text-align: center;
    padding: 4rem 1.5rem 6rem;
  }
  .hero-glow {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 75% 55% at 50% 25%, rgba(201,168,76,.2) 0%, transparent 65%),
      radial-gradient(ellipse 45% 70% at 85% 75%, rgba(61,107,44,.14) 0%, transparent 60%),
      linear-gradient(150deg, #0D0A05 0%, #1A1208 45%, #0A0804 100%);
  }
  .hero-pattern {
    position: absolute; inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23C9A84C' fill-opacity='0.035' fill-rule='evenodd'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/svg%3E");
  }

  .hero-inner { position: relative; z-index: 2; max-width: 920px; animation: fadeUp 1.1s ease both; }

  .hero-eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.4rem;
    opacity: .85;
  }

  h1.hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(3.2rem, 8.5vw, 7.5rem);
    font-weight: 900;
    line-height: 1;
    color: var(--cream);
    margin-bottom: .25em;
  }
  h1.hero-title em {
    font-style: italic;
    color: var(--gold);
    display: block;
  }

  .hero-sub {
    font-family: 'Crimson Pro', serif;
    font-size: clamp(1.1rem, 2.5vw, 1.55rem);
    font-style: italic;
    font-weight: 300;
    color: rgba(245,237,216,.65);
    margin: 1rem auto 2rem;
    max-width: 560px;
  }

  .hero-date-chip {
    display: inline-flex;
    gap: 1.2rem;
    align-items: center;
    background: rgba(201,168,76,.11);
    border: 1px solid rgba(201,168,76,.32);
    border-radius: 100px;
    padding: .55rem 1.6rem;
    font-family: 'DM Sans', sans-serif;
    font-size: .9rem;
    font-weight: 600;
    color: var(--gold-light);
    letter-spacing: .04em;
    margin-bottom: 2rem;
  }
  .hero-date-chip span { opacity: .35; font-weight: 300; }

  /* early bird hero block */
  .eb-block {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    background: linear-gradient(135deg,rgba(201,168,76,.18),rgba(201,168,76,.07));
    border: 1px solid rgba(201,168,76,.45);
    border-radius: 10px;
    padding: 1.1rem 2rem;
    margin-bottom: 2.2rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .eb-left .eb-tag {
    font-family: 'DM Sans', sans-serif;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--terra);
    background: rgba(160,68,42,.18);
    border-radius: 4px;
    padding: .2em .6em;
    display: inline-block;
    margin-bottom: .4rem;
  }
  .eb-price {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.4rem,5vw,3.4rem);
    font-weight: 900;
    color: var(--gold-light);
    line-height: 1;
  }
  .eb-perpax {
    font-family: 'DM Sans', sans-serif;
    font-size: .75rem;
    color: rgba(245,237,216,.45);
    letter-spacing: .06em;
  }
  .vdiv { width:1px; height:3.5rem; background:rgba(201,168,76,.28); }
  .eb-right .eb-norm-label {
    font-family: 'DM Sans', sans-serif;
    font-size: .68rem;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: rgba(245,237,216,.35);
    margin-bottom: .3rem;
  }
  .eb-norm-price {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    font-weight: 700;
    color: rgba(245,237,216,.28);
    text-decoration: line-through;
    line-height: 1;
  }
  .eb-saving {
    font-family: 'DM Sans', sans-serif;
    font-size: .78rem;
    color: #6fcf97;
    font-weight: 600;
    margin-top: .3rem;
  }

  /* buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    letter-spacing: .04em;
    text-decoration: none;
    border-radius: 5px;
    transition: all .22s ease;
    white-space: nowrap;
  }
  .btn-gold {
    background: linear-gradient(135deg, var(--gold) 0%, #B8922F 100%);
    color: var(--deep);
    padding: 1rem 2.2rem;
    font-size: 1rem;
    text-transform: uppercase;
    box-shadow: 0 4px 28px rgba(201,168,76,.42);
  }
  .btn-gold:hover { transform:translateY(-2px); box-shadow:0 8px 38px rgba(201,168,76,.6); }
  .btn-gold.lg { font-size:1.1rem; padding:1.15rem 2.8rem; }

  .btn-wa {
    background: #25D366;
    color: #fff;
    padding: 1rem 2.2rem;
    font-size: 1rem;
    box-shadow: 0 4px 20px rgba(37,211,102,.3);
  }
  .btn-wa:hover { transform:translateY(-2px); background:#1ebe5d; box-shadow:0 8px 28px rgba(37,211,102,.5); }
  .btn-wa.lg { font-size:1.1rem; padding:1.15rem 2.8rem; }

  .btn-call {
    background: var(--blue-cta);
    color: #fff;
    padding: 1rem 2.2rem;
    font-size: 1rem;
    box-shadow: 0 4px 20px rgba(26,115,232,.3);
  }
  .btn-call:hover { transform:translateY(-2px); background:#1558b0; }
  .btn-call.lg { font-size:1.1rem; padding:1.15rem 2.8rem; }

  .btn-group { display:flex; gap:.9rem; flex-wrap:wrap; justify-content:center; }

  .scroll-hint {
    position:absolute; bottom:2rem; left:50%; transform:translateX(-50%);
    color:rgba(201,168,76,.4);
    font-family:'DM Sans',sans-serif; font-size:.7rem; letter-spacing:.22em; text-transform:uppercase;
    animation:bounce 2s infinite;
  }

  /* ══ GENERIC SECTION ══ */
  .sec { padding: 6.5rem 1.5rem; }
  .sec-dark { background:var(--bark); }
  .sec-white { background:#fff; }
  .sec-cream { background:var(--cream-light); }
  .sec-earth { background:var(--earth); }

  .container { max-width:860px; margin:0 auto; }
  .container-wide { max-width:1080px; margin:0 auto; }

  .label {
    font-family:'DM Sans',sans-serif;
    font-size:.7rem; font-weight:700; letter-spacing:.3em; text-transform:uppercase;
    color:var(--terra); display:block; margin-bottom:.9rem;
  }
  .label-gold { color:var(--gold); }

  h2.stitle {
    font-family:'Playfair Display',serif;
    font-size:clamp(1.9rem,4.5vw,3.3rem);
    font-weight:700; line-height:1.15;
    color:var(--earth); margin-bottom:1.3rem;
  }
  h2.stitle em { font-style:italic; color:var(--gold); }
  h2.stitle.light { color:var(--cream); }

  .lead { font-size:1.2rem; color:var(--text-soft); font-weight:300; margin-bottom:1.3rem; }
  .lead.light { color:rgba(245,237,216,.75); }

  p.body { color:var(--text-soft); margin-bottom:1.2rem; font-size:1.05rem; }
  p.body.light { color:rgba(245,237,216,.75); }

  .hbox {
    background:linear-gradient(135deg,#fff8ed,#fef3d8);
    border-left:4px solid var(--gold);
    padding:1.4rem 1.8rem;
    margin:2.2rem 0;
    border-radius:0 8px 8px 0;
  }
  .hbox p { font-size:1.15rem; font-style:italic; color:var(--text); margin:0; }
  .hbox.dark { background:rgba(201,168,76,.08); border-color:var(--gold); }
  .hbox.dark p { color:var(--cream); }

  /* ══ QUOTE ══ */
  .quote-sec {
    background:var(--earth);
    padding:5.5rem 1.5rem;
    text-align:center;
  }
  blockquote {
    max-width:680px; margin:0 auto;
    font-family:'Playfair Display',serif;
    font-size:clamp(1.35rem,3.2vw,2rem);
    font-style:italic; color:var(--cream); line-height:1.45;
    position:relative;
  }
  blockquote::before {
    content:'\201C';
    font-size:8rem; color:rgba(201,168,76,.18);
    position:absolute; top:-3rem; left:-1.5rem;
    font-family:Georgia,serif; line-height:1;
  }
  blockquote cite {
    display:block; margin-top:1.4rem;
    font-family:'DM Sans',sans-serif; font-size:.78rem;
    font-style:normal; letter-spacing:.22em; text-transform:uppercase; color:var(--gold);
  }

  /* ══ MID CTA BANNER ══ */
  .mid-cta {
    background:linear-gradient(135deg,var(--terra),#7a2e18);
    padding:3.5rem 1.5rem;
    text-align:center;
  }
  .mid-cta p {
    font-family:'Playfair Display',serif;
    font-size:clamp(1.3rem,3vw,1.9rem);
    font-style:italic;
    color:#fff;
    margin-bottom:1.6rem;
    max-width:600px; margin-left:auto; margin-right:auto;
  }

  /* ══ TIMELINE ══ */
  .timeline { position:relative; padding-left:0; margin-top:3rem; }
  .timeline::before {
    content:'';
    position:absolute; left:2.2rem; top:0; bottom:0;
    width:2px;
    background:linear-gradient(to bottom,var(--gold),transparent);
  }
  .tl-item {
    display:flex; gap:1.8rem; margin-bottom:2.4rem; align-items:flex-start;
    opacity:0; transform:translateX(-18px); transition:all .5s ease;
  }
  .tl-item.vis { opacity:1; transform:translateX(0); }
  .tl-dot {
    flex-shrink:0; width:2.4rem; height:2.4rem;
    background:linear-gradient(135deg,var(--gold),#B8922F);
    border-radius:50%; display:flex; align-items:center; justify-content:center;
    font-family:'DM Sans',sans-serif; font-size:.7rem; font-weight:700; color:var(--deep);
    box-shadow:0 0 0 4px rgba(201,168,76,.14); position:relative; z-index:1;
  }
  .tl-day {
    font-family:'DM Sans',sans-serif; font-size:.68rem; font-weight:700;
    letter-spacing:.18em; text-transform:uppercase; color:var(--gold); margin-bottom:.2rem;
  }
  .tl-title {
    font-family:'Playfair Display',serif; font-size:1.15rem; font-weight:700;
    color:var(--earth); margin-bottom:.35rem;
  }
  .tl-desc { font-size:.98rem; color:var(--text-soft); line-height:1.6; }

  /* ══ HOTELS ══ */
  .hotel-grid {
    display:grid; grid-template-columns:repeat(3,1fr); gap:1.4rem; margin-top:2.8rem;
  }
  .hotel-card {
    background:white; border-radius:8px; overflow:hidden;
    box-shadow:0 2px 18px rgba(0,0,0,.06);
    transition:transform .3s ease;
  }
  .hotel-card:hover { transform:translateY(-4px); }
  .hotel-top {
    background:linear-gradient(135deg,var(--earth),var(--bark));
    padding:1.4rem; text-align:center;
  }
  .hotel-nights { font-family:'Playfair Display',serif; font-size:2.4rem; font-weight:900; color:var(--gold); line-height:1; }
  .hotel-nl { font-family:'DM Sans',sans-serif; font-size:.68rem; letter-spacing:.18em; text-transform:uppercase; color:rgba(245,237,216,.45); margin-top:.15rem; }
  .hotel-body { padding:1.4rem; }
  .hotel-loc { font-family:'DM Sans',sans-serif; font-size:.68rem; font-weight:700; letter-spacing:.18em; text-transform:uppercase; color:var(--gold); margin-bottom:.25rem; }
  .hotel-name { font-family:'Playfair Display',serif; font-size:1.1rem; font-weight:700; color:var(--earth); margin-bottom:.3rem; }
  .hotel-type { font-size:.9rem; color:var(--text-soft); }

  /* ══ CHECKLIST ══ */
  .two-col { display:grid; grid-template-columns:1fr 1fr; gap:2.5rem; margin-top:2.8rem; }
  .col-title {
    font-family:'Playfair Display',serif; font-size:1.35rem; font-weight:700;
    color:var(--earth); margin-bottom:1.1rem;
    padding-bottom:.55rem; border-bottom:2px solid var(--gold); display:inline-block;
  }
  .clist { list-style:none; padding:0; }
  .clist li {
    display:flex; align-items:flex-start; gap:.75rem;
    margin-bottom:.7rem; font-size:.98rem; color:var(--text-soft); line-height:1.5;
  }
  .clist li::before { content:'✓'; color:var(--leaf); font-weight:700; font-size:.95rem; flex-shrink:0; margin-top:.12em; }
  .xlist li::before { content:'✗'; color:var(--terra); }

  /* ══ PRICE SECTION ══ */
  .price-sec {
    background:var(--deep);
    padding:8rem 1.5rem;
    text-align:center;
    position:relative; overflow:hidden;
  }
  .price-sec::before {
    content:''; position:absolute; inset:0;
    background:radial-gradient(ellipse 65% 55% at 50% 50%,rgba(201,168,76,.13) 0%,transparent 70%);
  }
  .price-inner { position:relative; z-index:1; }

  .pricing-duo {
    display:grid; grid-template-columns:1fr 1fr; gap:1.4rem;
    max-width:660px; margin:2.8rem auto;
  }
  .p-card {
    background:linear-gradient(135deg,rgba(201,168,76,.12),rgba(201,168,76,.04));
    border:1px solid rgba(201,168,76,.28);
    border-radius:12px; padding:2.4rem 1.8rem;
    position:relative; transition:transform .3s ease;
  }
  .p-card.feat {
    background:linear-gradient(135deg,rgba(201,168,76,.22),rgba(201,168,76,.1));
    border-color:var(--gold); transform:scale(1.04);
  }
  .p-card.feat:hover { transform:scale(1.06); }
  .p-badge {
    position:absolute; top:-1rem; left:50%; transform:translateX(-50%);
    background:var(--terra); color:#fff;
    font-family:'DM Sans',sans-serif; font-size:.65rem; font-weight:700;
    letter-spacing:.14em; text-transform:uppercase;
    padding:.32rem .95rem; border-radius:100px; white-space:nowrap;
  }
  .p-card-label {
    font-family:'DM Sans',sans-serif; font-size:.68rem; font-weight:700;
    letter-spacing:.18em; text-transform:uppercase; color:var(--gold); margin-bottom:.7rem; display:block;
  }
  .p-price {
    font-family:'Playfair Display',serif;
    font-size:clamp(2.6rem,5.5vw,3.8rem);
    font-weight:900; color:var(--gold); line-height:1; margin-bottom:.15em;
  }
  .p-price.dim { color:rgba(201,168,76,.45); }
  .p-per { font-family:'DM Sans',sans-serif; font-size:.75rem; color:rgba(245,237,216,.4); letter-spacing:.07em; margin-bottom:1rem; }

  .seats { display:flex; gap:.28rem; justify-content:center; margin:.9rem 0 .3rem; }
  .seat { width:1rem; height:1rem; border-radius:50%; background:rgba(201,168,76,.18); border:1.5px solid rgba(201,168,76,.35); }

  .seats-lbl { font-family:'DM Sans',sans-serif; font-size:.75rem; color:rgba(245,237,216,.45); margin-bottom:1.3rem; }

  .payment-box {
    max-width:500px; margin:0 auto 2.5rem;
    background:rgba(201,168,76,.08); border:1px solid rgba(201,168,76,.2);
    border-radius:8px; padding:1.2rem 1.8rem;
    font-family:'DM Sans',sans-serif; font-size:.88rem; color:rgba(245,237,216,.6); line-height:1.8;
  }
  .payment-box strong { color:var(--gold-light); }

  /* ══ CANCEL ══ */
  .pol-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.4rem; margin-top:2.4rem; }
  .pol-card {
    background:#fff; border-radius:8px; padding:1.7rem;
    text-align:center; border-top:3px solid var(--gold);
    box-shadow:0 2px 18px rgba(0,0,0,.05);
  }
  .pol-num { font-family:'Playfair Display',serif; font-size:2.3rem; font-weight:900; color:var(--gold); line-height:1; margin-bottom:.25rem; }
  .pol-card p { font-size:.93rem; color:var(--text-soft); margin:0; }

  /* ══ FINAL CTA ══ */
  .final-cta {
    background:linear-gradient(150deg,#1A1208 0%,#2C1F0E 55%,#1A1208 100%);
    padding:8rem 1.5rem;
    text-align:center; position:relative; overflow:hidden;
  }
  .final-cta::before {
    content:''; position:absolute; top:0; left:0; right:0; height:1px;
    background:linear-gradient(90deg,transparent,var(--gold),transparent);
  }

  /* ══ FOOTER ══ */
  footer {
    background:var(--deep);
    padding:2.8rem 1.5rem;
    text-align:center;
    font-family:'DM Sans',sans-serif; font-size:.82rem; color:rgba(245,237,216,.3);
    border-top:1px solid rgba(201,168,76,.12);
  }
  footer .flogo { font-family:'Playfair Display',serif; font-size:1.5rem; font-style:italic; color:var(--gold); display:block; margin-bottom:.4rem; }
  footer a { color:var(--gold); text-decoration:none; }

  /* ══ STICKY BAR ══ */
  .sticky {
    position:fixed; bottom:0; left:0; right:0; z-index:200;
    background:rgba(13,10,5,.96);
    border-top:1px solid rgba(201,168,76,.28);
    backdrop-filter:blur(12px);
    padding:.65rem 1.2rem;
    display:flex; align-items:center; justify-content:center;
    gap:.8rem; flex-wrap:wrap;
    box-shadow:0 -4px 30px rgba(0,0,0,.5);
  }
  .sticky p { font-family:'DM Sans',sans-serif; font-size:.8rem; color:rgba(245,237,216,.6); margin:0; }
  .sticky .eb-chip {
    background:var(--terra); color:#fff;
    font-family:'DM Sans',sans-serif; font-size:.68rem; font-weight:700;
    letter-spacing:.1em; text-transform:uppercase;
    padding:.22rem .65rem; border-radius:4px;
  }
  .sticky .btn { padding:.55rem 1.2rem; font-size:.8rem; }

  /* ══ ANIMATIONS ══ */
  @keyframes fadeUp { from{opacity:0;transform:translateY(28px)} to{opacity:1;transform:translateY(0)} }
  @keyframes bounce {
    0%,100%{transform:translateX(-50%) translateY(0)}
    50%{transform:translateX(-50%) translateY(6px)}
  }
  .fi { opacity:0; transform:translateY(22px); transition:opacity .65s ease,transform .65s ease; }
  .fi.vis { opacity:1; transform:translateY(0); }

  /* ══ RESPONSIVE ══ */
  @media(max-width:700px){
    .two-col,.hotel-grid,.pricing-duo,.pol-grid{grid-template-columns:1fr;}
    .p-card.feat{transform:scale(1);}
    .btn-group{flex-direction:column;align-items:center;}
    .eb-block{flex-direction:column;gap:.8rem;}
    .vdiv{display:none;}
    .timeline::before{left:1.1rem;}
    .sticky{gap:.5rem;}
    .hero-date-chip{flex-direction:column;gap:.3rem;}
  }
</style>
</head>
<body>

<!-- TOP STRIP -->
<div class="top-strip">
  🌿 <strong>EARLY BIRD:</strong> Primeras <span class="pill">6 plazas</span> a <strong>1.395 €</strong> · Después 1.595 € · Grupo máx. <strong>10 personas</strong>
</div>

<!-- ═══════════════════════ HERO ═══════════════════════ -->
<section class="hero">
  <div class="hero-glow"></div>
  <div class="hero-pattern"></div>
  <div class="hero-inner">

    <p class="hero-eyebrow">Renace Viajando Experiencias</p>

    <h1 class="hero-title">
      Sri Lanka
